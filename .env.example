# No environment variables are required for local development.
# The API proxy URL is hardcoded in app/api/chat/route.ts.
#
# For production Cloud Run deploy, configure these GitHub secrets:
# WIF_PROVIDER=projects/<project-number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
# WIF_SERVICE_ACCOUNT=<sa-name>@smartvolve-factory.iam.gserviceaccount.com
